# Copy to .env. npm run setup creates secure random local defaults in .env.local.
# Precedence: injected environment > .env > .env.local. Restart after edits.
# This file contains examples only, never real credentials.
RESEARCH_MODEL_MODE=simulation
PUBLIC_ORIGIN=http://127.0.0.1:3000

# Uncomment to override the generated owner password (minimum 14 characters).
# OWNER_PASSWORD=your-unique-owner-password
# SESSION_SECRET=your-unique-random-secret-at-least-32-characters
# INTERNAL_SERVICE_TOKEN=your-other-unique-random-secret-at-least-32-characters

# Azure OpenAI-compatible base URL, not a full chat/completions URL.
# For live research, change RESEARCH_MODEL_MODE to azure.
AZURE_AI_ENDPOINT=
AZURE_AI_MODEL=
RESEARCH_AZURE_KEY=
# Optional independent deployments; all fall back to AZURE_AI_MODEL.
AZURE_PLANNER_MODEL=
AZURE_SCIENCE_MODEL=
AZURE_COMMERCIAL_MODEL=
AZURE_ANALYTICS_MODEL=
AZURE_REVIEWER_MODEL=
AZURE_DIRECTOR_MODEL=
AZURE_MAX_COMPLETION_TOKENS=4000
# For Foundry /models endpoints only:
AZURE_AI_API_VERSION=2024-05-01-preview

# Optional broad web search; otherwise live mode uses limited Wikipedia discovery.
RESEARCH_SEARCH_KEY=

# Optional image model accepting images/generations and returning b64_json.
# Use the FULL generation URL, including api-version when your deployment needs it.
AZURE_IMAGE_ENDPOINT=
AZURE_IMAGE_MODEL=

# To use Supabase: set USE_EXTERNAL_DATABASE=true and uncomment/replace ALL nine URLs below.
# Supabase/PostgreSQL: use direct/session-pooler PostgreSQL connections, not the REST URL or anon key.
# Each service owns its schema; configure separate least-privilege database roles before deployment.
# Preserve verified TLS; never set sslmode=no-verify or disable certificate checks.
USE_EXTERNAL_DATABASE=false
# WORKSPACE_DATABASE_URL=postgresql://user:password@your-database:5432/postgres?schema=workspace
# KNOWLEDGE_DATABASE_URL=postgresql://user:password@your-database:5432/postgres?schema=knowledge
# RESEARCH_DATABASE_URL=postgresql://user:password@your-database:5432/postgres?schema=research
# ANALYTICS_DATABASE_URL=postgresql://user:password@your-database:5432/postgres?schema=analytics
# REPORT_DATABASE_URL=postgresql://user:password@your-database:5432/postgres?schema=report
# SCIENTIFIC_DATABASE_URL=postgresql://user:password@your-database:5432/postgres?schema=scientific
# EVIDENCE_DATABASE_URL=postgresql://user:password@your-database:5432/postgres?schema=evidence
# EXECUTION_DATABASE_URL=postgresql://user:password@your-database:5432/postgres?schema=execution
# VISUAL_DATABASE_URL=postgresql://user:password@your-database:5432/postgres?schema=visual

# Override when services run on separate hosts/containers. Keep service traffic private.
# WORKSPACE_SERVICE_URL=http://workspace:4101
# KNOWLEDGE_SERVICE_URL=http://knowledge:4102
# RESEARCH_SERVICE_URL=http://research:4103
# ANALYTICS_SERVICE_URL=http://analytics:4104
# REPORT_SERVICE_URL=http://report:4105
# VISUAL_SERVICE_URL=http://visual:4106
# NODE_ENV=production
# GATEWAY_HOST=0.0.0.0
# SERVICE_HOST=0.0.0.0

# Optional runtime paths (defaults use the prepared local tools).
# SCIENCE_PYTHON=/workspace/Research/data/science_venv/bin/python
# CHROMIUM_PATH=/usr/bin/chromium
# EXECUTION_IMAGE=python:3.12-slim@sha256:your-verified-runtime-image-digest
# SCIENTIFIC_SERVICE_URL=http://scientific:4107
# EVIDENCE_SERVICE_URL=http://evidence:4108
# EXECUTION_SERVICE_URL=http://execution:4109
# PLANNER_AGENT_SERVICE_URL=http://planner:4206

# Public source hosts explicitly approved for proxy-side DNS when local DNS is unavailable.
# en.wikipedia.org is included by default. Also allow each host in environment network settings.
RESEARCH_SOURCE_DOMAINS=
