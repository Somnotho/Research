generator client {
 provider = "prisma-client-js"
 engineType = "client"
 output = "../generated"
}
datasource db {
 provider = "postgresql"
 url = env("EXECUTION_DATABASE_URL")
}
model code_test {
 id String @id @default(uuid()) @db.Uuid
 project_id String @db.Uuid
 input Json
 state String @default("queued")
 result Json?
 created_at DateTime @default(now())
 @@index([project_id,created_at])
 @@index([state,created_at])
}

model service_migration {
 version String @id
 checksum String
 applied_at DateTime @default(now()) @db.Timestamptz(6)
}
