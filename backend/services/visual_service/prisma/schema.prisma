generator client {
 provider = "prisma-client-js"
 engineType = "client"
 output = "../generated"
}
datasource db {
 provider = "postgresql"
 url = env("VISUAL_DATABASE_URL")
}
model visual_asset {
 id String @id @default(uuid()) @db.Uuid
 project_id String @db.Uuid
 title String
 prompt String?
 kind String
 state String
 mime_type String
 content String
 error String?
 created_at DateTime @default(now())
 @@index([project_id])
 @@index([state,created_at])
}

model service_migration {
 version String @id
 checksum String
 applied_at DateTime @default(now()) @db.Timestamptz(6)
}
