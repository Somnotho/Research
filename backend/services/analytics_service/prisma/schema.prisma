generator client {
 provider = "prisma-client-js"
 engineType = "client"
 output = "../generated"
}
datasource db {
 provider = "postgresql"
 url = env("ANALYTICS_DATABASE_URL")
}

model scenario {
  id String @id @default(uuid()) @db.Uuid
  project_id String @db.Uuid
  label String
  result Json
  created_at DateTime @default(now())
  @@index([project_id])
}
model decision_matrix {
 id String @id @default(uuid()) @db.Uuid
 project_id String @db.Uuid
 label String
 input Json
 result Json
 created_at DateTime @default(now())
 @@index([project_id, created_at])
}

model service_migration {
 version String @id
 checksum String
 applied_at DateTime @default(now()) @db.Timestamptz(6)
}

model improvement_comparison {
 id String @id @default(uuid()) @db.Uuid
 project_id String @db.Uuid
 label String
 result Json
 created_at DateTime @default(now())
 @@index([project_id, created_at])
}
