generator client {
 provider = "prisma-client-js"
 engineType = "client"
 output = "../generated"
}
datasource db {
 provider = "postgresql"
 url = env("REPORT_DATABASE_URL")
}

model report {
  id String @id @default(uuid()) @db.Uuid
  project_id String @db.Uuid
  run_id String @unique @db.Uuid
  title String
  content String
  created_at DateTime @default(now())
  @@index([project_id])
}

model service_migration {
 version String @id
 checksum String
 applied_at DateTime @default(now()) @db.Timestamptz(6)
}
