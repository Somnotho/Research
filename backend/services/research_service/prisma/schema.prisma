generator client {
 provider = "prisma-client-js"
 engineType = "client"
 output = "../generated"
}
datasource db {
 provider = "postgresql"
 url = env("RESEARCH_DATABASE_URL")
}

model message {
  id String @id @default(uuid()) @db.Uuid
  project_id String @db.Uuid
  role String
  content String
  created_at DateTime @default(now())
  @@index([project_id, created_at])
}
model research_run {
  id String @id @default(uuid()) @db.Uuid
  project_id String @db.Uuid
  question String
  web_enabled Boolean @default(false)
  state String @default("queued")
  evidence Json?
  plan Json?
  limits Json?
  usage Json?
  cancel_requested Boolean @default(false)
  answer String?
  report_id String? @db.Uuid
  error String?
  created_at DateTime @default(now())
  completed_at DateTime?
  @@index([project_id])
  @@index([state, created_at])
}
model research_step {
  id String @id @default(uuid()) @db.Uuid
  run_id String @db.Uuid
  agent String
  state String
  detail String
  created_at DateTime @default(now())
  @@index([run_id, created_at])
}

model service_migration {
 version String @id
 checksum String
 applied_at DateTime @default(now()) @db.Timestamptz(6)
}
